# Copy to .env and fill in real values before running aio app run

# Adobe I/O Runtime namespace (set automatically by aio app use)
# AIO_RUNTIME_NAMESPACE=
# AIO_RUNTIME_AUTH=

LOG_LEVEL=info

# --- Adobe Commerce (ACCS) ---
# Full admin dashboard URL; the REST API base is derived from it
COMMERCE_SANDBOX_ADMIN_URL=
# Store view code sent in the Store header (default: all)
# COMMERCE_STORE=all
# Optional dedicated Commerce credential. If left empty, the project's shared
# OAuth S2S credential is used (IMS_OAUTH_S2S_SCOPES must include commerce.accs).
# COMMERCE_CLIENT_ID=
# COMMERCE_CLIENT_SECRET=
# COMMERCE_ORG_ID=

# --- ERP backend ---
# Base URL of the ERP REST API, e.g. https://erp.example.com/api
ERP_BASE_URL=
# Path orders are POSTed to (default: /orders)
# ERP_ORDERS_PATH=/orders
# Sent as Authorization: Bearer <ERP_API_KEY>
ERP_API_KEY=

# --- Export behaviour ---
# Comma-separated Commerce order statuses eligible for export (default: processing)
ORDER_STATUSES=processing
# First run only: export orders updated after this date (ISO). Default: last 24 hours
# SYNC_START_DATE=2026-11-01T00:00:00Z
